# dependencies
/node_modules

# next
/.next/
/out/
next-env.d.ts

# env (keys never leave the machine)
.env
.env.local
.env*.local

# database: generated by the seeder; only the seeded demo DB is versioned (needed on Vercel)
/data/*
!/data/.gitkeep
!/data/campuspulse.db

# never commit SQLite sidecar files
/data/*.db-wal
/data/*.db-shm

# misc
*.tsbuildinfo
coverage/
.DS_Store
npm-debug.log*
